#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

VERSION="v0.0.0-1"
PROGRAM="gh-repo-reset"
SOURCE_REPO="${GH_REPO_RESET_SOURCE_REPO:-ran-dall/gh-repo-reset}"
SOURCE_REF="${GH_REPO_RESET_SOURCE_REF:-$VERSION}"
SPEC_FILE="gh-repo-reset.usage.kdl"

MODULES=(
  core.sh
  snapshot.sh
  git.sh
  report.sh
  safety.sh
  restore.sh
  integrations.sh
  followup.sh
  main.sh
)

source_refs() {
  printf '%s\n' "$SOURCE_REF"
  if [[ -z "${GH_REPO_RESET_SOURCE_REF+x}" && "$SOURCE_REF" == "$VERSION" ]]; then
    printf '%s\n' main
  fi
}

validate_source_repo() {
  [[ "$SOURCE_REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
}

print_usage_spec() {
  local script_path="${BASH_SOURCE[0]:-}" script_dir candidate ref endpoint

  if [[ -n "$script_path" && -f "$script_path" ]]; then
    script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
    candidate="$script_dir/$SPEC_FILE"
    if [[ -f "$candidate" ]]; then
      cat "$candidate"
      return 0
    fi
  fi

  validate_source_repo || {
    printf '[%s] ERROR: invalid GH_REPO_RESET_SOURCE_REPO: %s\n' "$PROGRAM" "$SOURCE_REPO" >&2
    return 1
  }
  command -v gh >/dev/null 2>&1 || {
    printf '[%s] ERROR: gh is required to fetch %s during streamed execution.\n' "$PROGRAM" "$SPEC_FILE" >&2
    return 1
  }
  gh auth status >/dev/null 2>&1 || {
    printf '[%s] ERROR: GitHub CLI is not authenticated; run: gh auth login\n' "$PROGRAM" >&2
    return 1
  }

  while IFS= read -r ref; do
    endpoint="repos/$SOURCE_REPO/contents/$SPEC_FILE?ref=$ref"
    if gh api "$endpoint" -H 'Accept: application/vnd.github.raw+json' 2>/dev/null; then
      return 0
    fi
  done < <(source_refs)

  printf '[%s] ERROR: could not fetch %s from %s@%s\n' "$PROGRAM" "$SPEC_FILE" "$SOURCE_REPO" "$SOURCE_REF" >&2
  return 1
}

if [[ "${1:-}" == "__usage_spec__" ]]; then
  print_usage_spec
  exit $?
fi

load_modules() {
  local dir="$1" module
  for module in "${MODULES[@]}"; do
    [[ -f "$dir/$module" ]] || {
      printf '[%s] ERROR: missing module: %s\n' "$PROGRAM" "$module" >&2
      return 1
    }
    if ! bash -n "$dir/$module"; then
      printf '[%s] ERROR: invalid Bash syntax in module: %s\n' "$PROGRAM" "$module" >&2
      return 1
    fi
  done
  for module in "${MODULES[@]}"; do
    # shellcheck source=/dev/null
    if ! source "$dir/$module"; then
      printf '[%s] ERROR: failed to load module: %s\n' "$PROGRAM" "$module" >&2
      return 1
    fi
  done
}

find_local_modules() {
  local script_path="${BASH_SOURCE[0]:-}" script_dir candidate

  if [[ -n "${GH_REPO_RESET_LIB_DIR:-}" ]]; then
    [[ -d "$GH_REPO_RESET_LIB_DIR" ]] || return 1
    printf '%s\n' "$GH_REPO_RESET_LIB_DIR"
    return 0
  fi

  [[ -n "$script_path" && -f "$script_path" ]] || return 1
  script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"

  # Repository checkout layout.
  candidate="$script_dir/lib"
  if [[ -d "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

fetch_remote_modules() {
  validate_source_repo || {
    printf '[%s] ERROR: invalid GH_REPO_RESET_SOURCE_REPO: %s\n' "$PROGRAM" "$SOURCE_REPO" >&2
    exit 1
  }
  command -v gh >/dev/null 2>&1 || {
    printf '[%s] ERROR: gh is required to bootstrap modules during streamed execution.\n' "$PROGRAM" >&2
    exit 1
  }
  gh auth status >/dev/null 2>&1 || {
    printf '[%s] ERROR: GitHub CLI is not authenticated; run: gh auth login\n' "$PROGRAM" >&2
    exit 1
  }

  local tmp module endpoint ref ok first limit pid owner name expr manifest truncated body graphql_ok
  local -a pids=()
  local query='query($owner:String!,$name:String!,$expr:String!){repository(owner:$owner,name:$name){object(expression:$expr){... on Tree{entries{name type object{... on Blob{text isTruncated}}}}}}}'

  tmp="$(mktemp -d)"
  limit="${GH_REPO_RESET_JOBS:-4}"
  [[ "$limit" =~ ^[1-9][0-9]*$ ]] || limit=4
  first="${MODULES[0]}"
  owner="${SOURCE_REPO%%/*}"
  name="${SOURCE_REPO#*/}"
  manifest="$tmp/modules.tsv"

  while IFS= read -r ref; do
    ok=1
    graphql_ok=0
    rm -f "$tmp"/*.sh "$manifest"
    expr="$ref:lib"

    # Fast path: fetch every module blob in lib/ in one GraphQL request.
    if gh api graphql \
      -f query="$query" \
      -f owner="$owner" \
      -f name="$name" \
      -f expr="$expr" \
      --jq '.data.repository.object.entries[]? | select(.type=="blob" and (.name|endswith(".sh"))) | [.name, (.object.isTruncated|tostring), (.object.text // "")] | @tsv' \
      > "$manifest" 2>/dev/null; then
      if [[ -s "$manifest" ]]; then
        while IFS=$'\t' read -r module truncated body; do
          [[ -n "$module" ]] || continue
          if [[ "$truncated" != false ]]; then
            ok=0
            break
          fi
          printf '%b' "$body" > "$tmp/$module"
        done < "$manifest"

        if (( ok )); then
          for module in "${MODULES[@]}"; do
            [[ -s "$tmp/$module" ]] || { ok=0; break; }
          done
        fi

        if (( ok )); then
          graphql_ok=1
        fi
      else
        # A successful query with no lib tree means this ref does not exist.
        continue
      fi
    fi

    if (( ! graphql_ok )); then
      # Compatibility fallback: bounded parallel REST content fetches.
      ok=1
      rm -f "$tmp"/*.sh
      endpoint="repos/$SOURCE_REPO/contents/lib/$first?ref=$ref"
      if ! gh api "$endpoint" -H 'Accept: application/vnd.github.raw+json' >"$tmp/$first" 2>/dev/null; then
        continue
      fi

      pids=()
      for module in "${MODULES[@]:1}"; do
        endpoint="repos/$SOURCE_REPO/contents/lib/$module?ref=$ref"
        gh api "$endpoint" -H 'Accept: application/vnd.github.raw+json' >"$tmp/$module" 2>/dev/null &
        pids+=("$!")
        if (( ${#pids[@]} >= limit )); then
          for pid in "${pids[@]}"; do
            wait "$pid" || ok=0
          done
          pids=()
        fi
      done
      for pid in "${pids[@]}"; do
        wait "$pid" || ok=0
      done
    fi

    if (( ok )); then
      if [[ "$ref" != "$SOURCE_REF" ]]; then
        printf '[%s] WARNING: %s is not published yet; bootstrapping modules from %s.\n' "$PROGRAM" "$SOURCE_REF" "$ref" >&2
      fi
      printf '%s\n' "$tmp"
      return 0
    fi
  done < <(source_refs)

  rm -rf "$tmp"
  printf '[%s] ERROR: could not bootstrap modules from %s@%s\n' "$PROGRAM" "$SOURCE_REPO" "$SOURCE_REF" >&2
  exit 1
}

MODULE_DIR=""
BOOTSTRAP_DIR=""
if MODULE_DIR="$(find_local_modules)" && [[ -n "$MODULE_DIR" ]]; then
  :
else
  BOOTSTRAP_DIR="$(fetch_remote_modules)"
  MODULE_DIR="$BOOTSTRAP_DIR"
fi

load_modules "$MODULE_DIR" || {
  [[ -n "$BOOTSTRAP_DIR" ]] && rm -rf "$BOOTSTRAP_DIR"
  printf '[%s] ERROR: incomplete module set in %s\n' "$PROGRAM" "$MODULE_DIR" >&2
  exit 1
}

[[ -n "$BOOTSTRAP_DIR" ]] && rm -rf "$BOOTSTRAP_DIR"
gh_repo_reset_main "$@"